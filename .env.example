# OmniClip AI Configuration
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional LLM API Keys for AI Clip Virality Scoring (OpenAI or Google Gemini)
# If omitted, OmniClip automatically uses the high-performance local heuristic model ($0 cost)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional yt-dlp Cookies File Path (for age-restricted or private YouTube videos)
YTDLP_COOKIES_PATH=

# Video Processing Limits
MAX_VIDEO_DURATION_MINUTES=120
MAX_UPLOAD_SIZE_MB=500
